---
extends: default

rules:
  line-length:
    max: 200
    level: warning

  indentation:
    spaces: 2
    indent-sequences: true

  comments:
    min-spaces-from-content: 1

  # ansible-lint requires these settings for its own yaml rule to work.
  comments-indentation: false

  braces:
    max-spaces-inside: 1

  document-start:
    present: true

  empty-lines:
    max: 3

  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    check-keys: false

  octal-values:
    forbid-implicit-octal: true